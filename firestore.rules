rules_version = '2';

// An account reads and writes only its own settings document, users/{uid},
// and the documents under it. Everything else is refused, because no other rule allows it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
